<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        System-bar transparency is declared here, at window creation, not only
        applied at runtime: enableEdgeToEdge() and the SideEffect in
        IvorMusicTheme still run, but several OEM skins (HyperOS/MIUI and
        friends on API 30-34) decide their own status-bar scrim from the theme
        attributes the window was created with and ignore the later runtime
        setters - which is why the status bar was opaque on those devices and
        transparent everywhere else. AOSP only ever scrims the navigation bar;
        the status-bar scrim is OEM-added, hence enforceStatusBarContrast too.
    -->
    <style name="Theme.IvorMusic" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <!-- Draw into the camera cutout on every edge from the moment the
             window exists. MainActivity also sets this at runtime, but
             like the bar colours above, some OEM skins only honour what
             the window was created with, which left landscape boxed in
             beside the notch. Screens keep their controls clear of it. -->
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>

    <!-- Splash Screen Theme (Android 12+) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background color (Deep Purple) -->
        <item name="windowSplashScreenBackground">#000000</item>
        <!-- Use the animated vector drawable we created -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_splash</item>
        <!-- Set the animation duration (match the AVD duration) -->
        <item name="windowSplashScreenAnimationDuration">800</item>
        <!-- Post-splash theme (the actual app theme) -->
        <item name="postSplashScreenTheme">@style/Theme.IvorMusic</item>
        <!-- The activity window is created under this theme, so the
             cutout mode has to be declared here too. -->
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>
</resources>