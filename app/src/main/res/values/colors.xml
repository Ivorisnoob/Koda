<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!--
        Notification colours.

        The app rule is that colour always comes from the Compose ColorScheme,
        but notifications are drawn by SystemUI outside our theme and the
        ProgressStyle segment APIs take a plain @ColorInt. These are the only
        place static colour values are legitimate; they are picked to read on
        both light and dark system notification backgrounds.
    -->
    <color name="notification_progress_preparing">#FF7E57C2</color>
    <color name="notification_progress_transfer">#FF00C853</color>

    <!-- Playback progress. Distinct from the download colours so a glance at
         the chip says which of the two it is. -->
    <color name="notification_progress_playback">#FF2196F3</color>
</resources>