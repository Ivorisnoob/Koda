<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Theme.IvorMusic comes from values/themes.xml, with its contrast
         and cutout attributes from values-v30 (Platform.Theme.IvorMusic). -->

    <!-- Splash Screen Theme (Android 12+) — uses Material You dynamic color -->
    <style name="Theme.App.Starting" parent="Platform.App.Starting">
        <!-- Dynamic wallpaper-derived dark background (neutral shade 900) -->
        <item name="windowSplashScreenBackground">@android:color/system_neutral1_900</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_splash</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.IvorMusic</item>
    </style>
</resources>
