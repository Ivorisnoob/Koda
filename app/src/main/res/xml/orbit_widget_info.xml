<?xml version="1.0" encoding="utf-8"?>
<!--
    1x1 round cover with a play button centred on it.

    updatePeriodMillis is 0 for every widget in the family: MusicService pushes
    a redraw on each playback event, so scheduled polling would only burn
    battery redrawing the same picture.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="90dp"
    android:minHeight="90dp"
    android:minResizeWidth="90dp"
    android:minResizeHeight="90dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:resizeMode="none"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="0"
    android:description="@string/widget_orbit_description"
    android:initialLayout="@layout/glance_default_loading_layout" />
