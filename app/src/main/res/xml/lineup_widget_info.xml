<?xml version="1.0" encoding="utf-8"?>
<!--
    4x2 queue: what is playing on top, the next few tracks below, each row a jump.

    MusicService pushes a redraw on each playback event; the 30-minute
    updatePeriodMillis heartbeat (the platform floor) exists only so a widget
    frozen by an OEM force-killing the app eventually corrects itself.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="1800000"
    android:description="@string/widget_lineup_description"
    android:previewLayout="@layout/widget_preview_lineup"
    android:previewImage="@drawable/widget_preview_lineup_image"
    android:initialLayout="@layout/glance_default_loading_layout" />
