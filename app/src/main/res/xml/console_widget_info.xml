<?xml version="1.0" encoding="utf-8"?>
<!--
    4x1 transport strip: previous, play, next, and - given the width - shuffle and repeat. No artwork, no text.

    MusicService pushes a redraw on each playback event; the 30-minute
    updatePeriodMillis heartbeat (the platform floor) exists only so a widget
    frozen by an OEM force-killing the app eventually corrects itself.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="200dp"
    android:minHeight="56dp"
    android:minResizeWidth="200dp"
    android:minResizeHeight="56dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="1800000"
    android:description="@string/widget_console_description"
    android:previewLayout="@layout/widget_preview_console"
    android:previewImage="@drawable/widget_preview_console_image"
    android:initialLayout="@layout/glance_default_loading_layout" />
