<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- EncryptedSharedPreferences keys are device-bound; restoring only the
         ciphertext makes the session store unreadable on the new device. -->
    <exclude domain="sharedpref" path="yt_music_session.xml"/>
    <!-- Configured Stremio transport paths can contain debrid API keys. -->
    <exclude domain="sharedpref" path="tv_addons.xml"/>
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
-->
</full-backup-content>
