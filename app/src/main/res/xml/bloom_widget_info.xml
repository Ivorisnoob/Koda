<?xml version="1.0" encoding="utf-8"?>
<!--
    2x2 of album art cut into a twelve-lobed cookie, with the hero in the corner.

    updatePeriodMillis is 0 for every widget in the family: MusicService pushes
    a redraw on each playback event, so scheduled polling would only burn
    battery redrawing the same picture.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="140dp"
    android:minHeight="140dp"
    android:minResizeWidth="140dp"
    android:minResizeHeight="140dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="0"
    android:description="@string/widget_bloom_description"
    android:initialLayout="@layout/glance_default_loading_layout" />
