<?xml version="1.0" encoding="utf-8"?>
<!--
    Picker preview for the Deck widget (2x4 vertical player): cover, track,
    progress, transport, shuffle and repeat.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="14dp">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:contentDescription="@null"
        android:src="@drawable/widget_preview_art" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="@string/widget_preview_title"
        android:textColor="#FFF2DEE5"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="@string/widget_preview_artist"
        android:textColor="#FFD6BFC8"
        android:textSize="12sp" />

    <!--
        Two views rather than a ProgressBar: the platform style is drawn in the
        device's own accent, so the one strip in this preview would be a
        different colour on every phone the picker is opened on.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/widget_preview_progress_track"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="35"
            android:background="@drawable/widget_preview_progress_fill" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="65" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_preview_tonal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/widget_action_previous"
                android:tint="#FFF2DEE5"
            android:src="@drawable/ic_media_previous" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_preview_play">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@string/widget_action_play"
                android:tint="#FF5E1133"
            android:src="@drawable/ic_media_play" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_preview_tonal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/widget_action_next"
                android:tint="#FFF2DEE5"
            android:src="@drawable/ic_media_next" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_preview_tonal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/widget_action_shuffle"
                android:tint="#FFF2DEE5"
            android:src="@drawable/ic_media_shuffle" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_preview_tonal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/widget_action_repeat"
                android:tint="#FFF2DEE5"
            android:src="@drawable/ic_media_repeat" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
