<?xml version="1.0" encoding="utf-8"?>
<!--
    Picker preview for the Vinyl widget (4x2): a record half out of its sleeve,
    with play and next beside it. No card behind it, because the widget has
    none - it stands on the wallpaper. Fixed colours throughout, from the
    family's preview palette (drawable/widget_preview_card.xml).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="8dp">

    <FrameLayout
        android:layout_width="140dp"
        android:layout_height="92dp">

        <ImageView
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="6dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_preview_vinyl_record" />

        <ImageView
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="@null"
            android:src="@drawable/widget_preview_art" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_preview_play">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/widget_action_play"
                android:tint="#FF5E1133"
                android:src="@drawable/ic_media_play" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_preview_tonal_square">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/widget_action_next"
                android:tint="#FFF2DEE5"
                android:src="@drawable/ic_media_next" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
